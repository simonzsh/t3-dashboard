{
  "name": "t3-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --hot src/main.ts",
    "demo": "bun scripts/demo.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "build": "bun run scripts/build.ts",
    "smoke": "bun run scripts/smoke.ts",
    "contracts": "bun run scripts/contracts.ts"
  },
  "dependencies": {
    "lucide": "^1.61.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.15.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
